{
  "opencollection": "1.0.0",
  "info": {
    "name": "NOWPayments Authentication Currencies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Currencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nowpayments.io/v1/currencies"
          },
          "docs": "Returns a list of all cryptocurrencies available for payment."
        }
      ]
    }
  ],
  "bundled": true
}