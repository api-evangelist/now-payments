{
  "opencollection": "1.0.0",
  "info": {
    "name": "NOWPayments Authentication Status API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nowpayments.io/v1/status"
          },
          "docs": "Returns the current status of the NOWPayments API."
        }
      ]
    }
  ],
  "bundled": true
}